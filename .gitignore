# Ignore system and log files
/writable/*
!/writable/index.html
!/writable/.htaccess
!/writable/uploads/
!/writable/cache/

# Ignore environment-specific files
.env
writable/logs/*

# Ignore Composer dependency directories
/vendor/*
!/vendor/autoload.php
!/vendor/composer/

# Ignore OS-generated files
.DS_Store
Thumbs.db

# Ignore PHPUnit test result cache
.phpunit.result.cache
